# ── Required ──────────────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Model ─────────────────────────────────────────────────────────────────────
# gemini-2.0-flash  → free tier, 1500 req/day (recommended)
# gemini-1.5-flash  → fallback if 2.0 is unavailable
GEMINI_MODEL=gemini-2.0-flash

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=dev          # set to "production" on deployed instances
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, zero-config)
DATABASE_URL=sqlite:///./skillbridge.db
# PostgreSQL (swap this in for production scale, no code changes needed)
# DATABASE_URL=postgresql://user:pass@host:5432/skillbridge

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Dev:  http://localhost:5173,http://127.0.0.1:5173
# Prod: replace with your deployed frontend URL
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
